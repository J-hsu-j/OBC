package endurosat.macif

<** @description: This is specific interface modified based on system configuraiton.
    @details: id = 30
**>
interface nvm_eps
{
    version { major 0 minor 1 }

    <** @description: General status type used for SW-related communication and/or settings. **>
    enumeration StandardResult
    {
        <** @description: The operation is successful **>
        SUCCESS,
        <** @description: An error has occurred **>
        ERROR,
        <** @description: Invalid input arguments provided to the operation **>
        INVALID_ARGS,
        <** @description: The action related to the input data is not supported by the firmware **>
        NOT_SUPPORTED
    }

<** @description: EPS Battery Pack IDs. Here is an extensive list of all possible IDs of the BPs in a system. 
    Depending on count of the EPS BPs in the specific configuration only the first N of those will be used. **>
    enumeration EpsBpIdType
    {
// begin EPS BP generated code

    
        <** @description:  EPS Battery Pack ID  **>
        EPS_BP_0,    
        <** @description:  EPS Battery Pack ID  **>
        EPS_BP_1        
// end EPS BP generated code
    }

<** @description: EPS Battery Pack IDs. Here is an extensive list of all possible IDs of the EPS_III BPs in a system. 
    Depending on count of the EPS EPS_III BPs in the specific configuration only the first N of those will be used. **>
    enumeration EpsIIIBpIdType
    {
// begin EPS_III BP generated code

        <** @description:  EPSIII BP ID  **>
        EPSIII_BP_0        
// end EPS_III BP generated code
    }

<** @description: EPS Battery Pack IDs. Here is an extensive list of all possible IDs of the EPS_III PDM_As in a system. 
    Depending on count of the EPS EPS_III PDM_As in the specific configuration only the first N of those will be used. **>
    enumeration EpsIIIPdmAIdType
    {
// begin EPS_III PDM_A generated code

        <** @description:  EPSIII PDM_A ID  **>
        EPSIII_PDM_A_0        
// end EPS_III PDM_A generated code
    }

<** @description: EPS Battery Pack IDs. Here is an extensive list of all possible IDs of the EPS_III PDM_Bs in a system. 
    Depending on count of the EPS_III PDM_Bs in the specific configuration only the first N of those will be used. **>
    enumeration EpsIIIPdmBIdType
    {
// begin EPS_III PDM_B generated code

        <** @description:  EPSIII PDM_B ID  **>
        EPSIII_PDM_B_0        
// end EPS_III PDM_B generated code
    }
    

<** @description: EPS Battery Pack IDs. Here is an extensive list of all possible IDs of the EPS_III INPUT_STAGE in a system. 
    Depending on count of the EPS EPS_III INPUT_STAGEs in the specific configuration only the first N of those will be used. **>
    enumeration EpsIIIInputStageIdType
    {
// begin EPS_III INPUT_STAGE generated code

        <** @description:  EPSIII INPUT_STAGE ID  **>
