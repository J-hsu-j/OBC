package endurosat.macif

<** @description: Control and configuration interface of the FDIR service on OBC
    @details: id = 29
**>
interface fdir_srv
{
    version { major 0 minor 2 }

    enumeration return_status
    {
        <** @description: No fault detected **>
        SUCCESS = 0

        <** @description: Invalid fault id input **>
        ERROR_INVALID_FAULT_ID

        <** @description: Invalid agent id input **>
        ERROR_INVALID_AGENT_ID

        <** @description: Invalid fdir level input **>
        ERROR_INVALID_FDIR_LEVEL

        <** @description: Attempting to raise a fault whose detection is not enabled **>
        ERROR_FAULT_DETECTION_DISABLED

        <** @description: Attempting to (non-force) clear a fault whose level is above autoclear **>
        ERROR_FAULT_LEVEL_ABOVE_AUTOCLEAR

        <** @description: Internal device error **>
        ERROR_INTERNAL
    }

    <** @description: Retrieves the overall FDIR level of the system
        @details: id = 0x00000001
    **>
    method get_system_fdir_level
    {
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: System FDIR level **>
            UInt8 fdir_level
        }
    }

    <** @description: Retrieves the FDIR level of a given agent
        @details: id = 0x00000002
    **>
    method get_agent_fdir_level
    {
        in
        {
            <** @description: Identifier of the checked agent **>
            UInt16 agent_id
        }
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: Maximum level of active faults detected by the agent **>
            UInt8 fdir_level
        }
    }

    <** @description: Retrieves whether detection is enabled for a given fault
        @details: id = 0x00000003
    **>
    method get_detection_for_fault
    {
        in
        {
            <** @description: Identifier of the checked fault **>
            UInt16 fault_id
        }
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: True if detection is active, False otherwise **>
            Boolean detection_enabled
        }
    }

    <** @description: Sets whether detection is enabled for a given fault
        @details: id = 0x00000004
    **>
    method set_detection_for_fault
    {
       in
       {
            <** @description: Identifier of the fault the detection of which is being set **>
            UInt16 fault_id

            <** @description: True to enable detection, False to disable **>
            Boolean set_detection_enabled
       }
       out
       {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: True if detection is active, False otherwise **>
            Boolean detection_enabled
       }
    }

    <** @description: Sets whether detection is enabled for all faults.
            Fault detection is being set from lowest to highest id.
            The first fault that returns an error will stop the clearing process and its id will be returned.
            If result is SUCCESS, then all faults were modified and fault_id will be the last id modified.
        @details: id = 0x00000014
    **>
    method set_detection_for_all_faults
    {
       in
       {
            <** @description: True to enable detection, False to disable **>
            Boolean set_detection_enabled
       }
       out
       {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: Identifier of the last fault being processed **>
            UInt16 fault_id

       }
    }

    <** @description: Gets a threshold below which the system FDIR level cannot drop.
        @details: id = 0x00000015
    **>
    method get_min_active_fdir
    {
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: System FDIR level when after the threshold is applied **>
            UInt8 fdir_level_set
        }
    }

    <** @description: Sets a threshold below which the system FDIR level cannot drop. Used to test
                      users of FDIR level without having to trigger the agents' fault detection logic
        @details: id = 0x00000005
    **>
    method set_min_active_fdir
    {
        in
        {
            <** @description: New value for the system FDIR level threshold **>
            UInt8 fdir_level
        }
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: System FDIR level when after the threshold is applied **>
            UInt8 fdir_level_set
        }
    }

    <** @description: Get the FDIR level at which the fault will no longer be cleared automatically by the system and only by the operator.
        @details: id = 0x00000007
    **>
    method get_fault_user_clear_level
    {
       out
       {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: The currently set automatic FDIR clear level ceiling. **>
            UInt8 fdir_level
       }
    }

    <** @description: Set the FDIR level at which the fault will no longer be cleared automatically by the system and only by the operator.
            It is used usually changed for testing purposes.
        @details: id = 0x00000006
    **>
    method set_fault_user_clear_level
    {
        in
        {
            <** @description: The level or higher at which automatic clearing of faults by the system is not possible.
                Faults at this level or higher can only be cleared through a an operator command.
                Possible values are 0-4, where at 0 no fault is cleared automatically, and at 4 every fault may be cleared automatically.
                By automatic clearing is meants that if the conditions of the fault are normal, the fault will no longer be active. **>
            UInt8 fdir_level
        }
        out
        {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: The current user clear level set **>
            UInt8 fdir_level_set
        }
    }

    <** @description: Gets the status of a given fault
        @details: id = 0x00000008
    **>
    method get_fault
    {
       in
       {
           <** @description: Identifier of the fault the detection of which is being set **>
           UInt16 fault_id
       }
       out
       {
            <** @description: Result of the operation. Ignore other output if not SUCCESS **>
            return_status status

            <** @description: True if fault is active, False otherwise **>
            Boolean is_active

            <** @description: The level of the fault, if active, otherwise the base level raised by this fault.
                A fault may have a higher level than the base level if its isolation and recovery action(s) fail. **>
            UInt8 fdir_level
       }
    }

    <** @description: Set a fault to active(raised) or inactive(cleared). This method is for testing purposes only.
        Raising a fault, that is already active and clearing a fault that is already inactive, is idempotent, i.e. it will not cause any changes in the system.
        Also raising a fault whose detection is disabled will be ignored. A fault will be cleared even if the detection is disabled.
        A fault will NOT be cleared if the fault level is equal to the autoclear level.
        Otherwise setting a fault will initiate the fault isolation and recovery (I&R) actions if such are implemented for given fault.
        This function does not bypass the fault detection logic and may be quickly set to a new state, depending on conditions and FDIR level of the fault.
        If an operator wishes to have a fault in a certain state irrespective of the detection logic, he should use the DataCache data layer for the particular fault.
        @details: id = 0x00000009
    **>
    method set_fault
    {
        in
        {
            <** @description: Identifier of the fault the detection of which is being set **>
            UInt16 fault_id
            <** @description: Identifier of the agent **>
            UInt16 agent_id
            <** @description: True if fault is active, False otherwise **>
            Boolean active
        }
        out
        {
            <** @description: Result of the operation **>
            return_status status
        }
    }

    <** @description: This function does not bypass the fault detection logic and may be quickly set to active, depending on conditions and FDIR level of the fault.
        This method is to be used by an operator to clear a fault that does not automatically recover,
        but the conditions must be met, otherwise the fault will be reactivated, with the I&R actions being executed again.
        If the fault is already inactive, i.e. clear, then nothing will happen.
        This function bypasses the autoclear level set by set_fault_autoclear_level and will clear any fault selected.
        It also bypasses the detection logic and will clear any fault selected even if fault detection is disabled.
        If an operator wishes suppress a fault, he may disable detection and then use this method to clear the fault.
        @details: id = 0x0000000A
    **>
    method force_clear_fault
    {
        in
        {
            <** @description: Identifier of the fault the detection of which is being set **>
            UInt16 fault_id
        }
        out
        {
            <** @description: Result of the operation **>
            return_status status
        }
    }

    <** @description: Same as force_clear_fault, but clears all faults.
            Faults are cleared from lowest to highest id.
            The first fault that returns an error will stop the clearing process and its id will be returned.
            If result is SUCCESS, then all faults were cleared and fault_id will be the last id cleared.
        @details: id = 0x0000000B
    **>
    method force_clear_all_faults
    {
        out
        {
            <** @description: Result of the operation **>
            return_status status

            <** @description: Identifier of the last fault being processed **>
            UInt16 fault_id
        }
    }

}

