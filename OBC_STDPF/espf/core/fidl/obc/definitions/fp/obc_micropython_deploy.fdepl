
import "../../spec/SpaceOpsMappingSpec.fdepl"
import "../../fp/obc_micropython.fidl"

define org.endurosat.spec.SpaceOpsMappingSpec for interface
endurosat.macif.obc_micropython as obc_micropython_Definitions {

	enumeration Result {
		AlarmInvalidRegexValues = {
			"QUEUE_FULL", "FAIL", "TIMED_OUT", "NOT_FOUND_IN_QUEUE"
		}
	}

	struct stime {
		hour {
			DisplayName = "Hour"
		}
		min {
			DisplayName = "Minutes"
		}
		sec {
			DisplayName = "Seconds"
		}
		ms {
			DisplayName = "Milliseconds"
		}
		us {
			DisplayName = "Microseconds"
		}
	}

	method RequestScriptExecution {
		in {
			script_full_name {
				DisplayName = "Script Full Name"
			}
			timeout_ms {
				DisplayName = "Timeout"
				Unit = "ms"
			}
		}
		out {
			script_id {
				DisplayName = "Script ID"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method GetScriptExecStatus {
		in {
			script_id {
				DisplayName = "Script ID"
			}
		}
		out {
			script_full_name {
				DisplayName = "Script Full Name"
			}
			op_result {
				DisplayName = "Result"
			}
			requested_time {
				DisplayName = "Requested Time"
			}
			time_started {
				DisplayName = "Time Started"
			}
			duration_ms {
				DisplayName = "Duration"
				Unit = "ms"
			}
		}
	}

}