			}
			raan {
				DisplayName = "RAAN"
			}
			ecc {
				DisplayName = "Eccentricity"
			}
			aop {
				DisplayName = "Argument of Perigee"
				Unit = "deg"
			}
			manomaly {
				DisplayName = "Mean Anomaly"
				Unit = "deg"
			}
			mmotion {
				DisplayName = "Mean Motion"
				Unit = "rev/day"
			}
			epoch {
				DisplayName = "Epoch"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

}