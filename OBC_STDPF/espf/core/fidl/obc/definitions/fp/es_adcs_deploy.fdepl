			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_estimator_ekf_config {
		in {
			desired_ekf_config {
				DisplayName = "Desired EKF Configuration"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_estimator_ekf_config {
		out {
			active_ekf_config {
				DisplayName = "Active EKF Configuration"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_controller_bdot_config {
		in {
			desired_bdot_config {
				DisplayName = "Desired B-Dot Configuration"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_controller_bdot_config {
		out {
			active_bdot_config {
				DisplayName = "Active B-Dot Configuration"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_controller_nadir_config {
		in {
			desired_nadir_config {
				DisplayName = "Desired Nadir Configuration"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_controller_nadir_config {
		out {
			active_nadir_config {
				DisplayName = "Active Nadir Configuration"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_magnetometer {
		in {
			desired_magnetometer {
				DisplayName = "Desired Magnetometer"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_magnetometer {
		out {
			active_magnetometer {
				DisplayName = "Active Magnetometer"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_adcs_config {
		in {
			desired_config {
				DisplayName = "Desired Configuration"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_adcs_config {
		out {
			active_config {
				DisplayName = "Active Configuration"
			}
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method save_adcs_config {
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method load_adcs_config {
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method set_sgp4_orbit_params {
		in {
			ftdmm {
				DisplayName = "FTDMM"
			}
			stdmm {
				DisplayName = "STDMM"
			}
			bstar {
				DisplayName = "BSTAR"
			}
			incl {
				DisplayName = "Inclination"
				Unit = "deg"
			}
			raan {
				DisplayName = "RAAN"
			}
			ecc {
				DisplayName = "Eccentricity"
			}
			aop {
				DisplayName = "Argument of Perigee"
				Unit = "deg"
			}
			manomaly {
				DisplayName = "Mean Anomaly"
				Unit = "deg"
			}
			mmotion {
				DisplayName = "Mean Motion"
				Unit = "rev/day"
			}
			epoch {
				DisplayName = "Epoch"
			}
		}
		out {
			op_result {
				DisplayName = "Result"
			}
		}
	}

	method get_sgp4_orbit_params {
		out {
			ftdmm {
				DisplayName = "FTDMM"
			}
			stdmm {
				DisplayName = "STDMM"
			}
			bstar {
				DisplayName = "BSTAR"
			}
			incl {
