
import "../../spec/SpaceOpsMappingSpec.fdepl"
import "../../fp/time.fidl"

define org.endurosat.spec.SpaceOpsMappingSpec for interface endurosat.pf.time as time_Definitions {

    enumeration op_status {
        AlarmInvalidRegexValues = {
            "ERROR"
        }
    }

    enumeration week_day {
        AlarmInvalidRegexValues = {
            "IVALID"
        }
    }

    struct sdate {
        year {
            DisplayName = "Year"
            AlarmNumericMinInclusive = "1999"
            AlarmNumericMaxInclusive = "2100"
        }
        mon {
            DisplayName = "Month"
            AlarmNumericMinInclusive = "0"
            AlarmNumericMaxInclusive = "13"
        }
        day {
            DisplayName = "Day"
            AlarmNumericMinInclusive = "0"
            AlarmNumericMaxInclusive = "32"
        }
        wday {
            DisplayName = "Week Day"
        }
    }

    struct stime {
        hour {
            DisplayName = "Hour"
            AlarmNumericMinInclusive = "-1"
            AlarmNumericMaxInclusive = "24"
        }
        min {
            DisplayName = "Minutes"
            AlarmNumericMinInclusive = "-1"
            AlarmNumericMaxInclusive = "60"
        }
        sec {
            DisplayName = "Seconds"
            AlarmNumericMinInclusive = "-1"
            AlarmNumericMaxInclusive = "60"
        }
        ms {
            DisplayName = "Milliseconds"
            AlarmNumericMinInclusive = "-1"
            AlarmNumericMaxInclusive = "1000"
        }
        us {
            DisplayName = "Microseconds"
            AlarmNumericMinInclusive = "-1"
            AlarmNumericMaxInclusive = "1000"
        }
    }

    struct s_rtc_info {
        enabled {
            DisplayName = "Enabled"
        }
        source {
            DisplayName = "Source"
        }
        rtc_asynchronous_prescaler {
            DisplayName = "RTC Asynchronous Prescaler"
        }
        rtc_synchronous_prescaler {
            DisplayName = "RTC Synchronous Prescaler"
        }
        hse_division_factor {
            DisplayName = "HSE Division Factor"
        }
    }

    method set_date {
        in {
            date {
                DisplayName = "Date"
            }
        }
        out {
            status {
                DisplayName = "Status"
            }
        }
    }

    method get_date {
        out {
            status {
                DisplayName = "Status"
            }
            date {
                DisplayName = "Date"
            }
        }
    }

    method set_time {
        in {
            time {
                DisplayName = "Time"
            }
        }
        out {
            status {
                DisplayName = "Status"
            }
        }
    }

    method get_time {
        out {
            status {
                DisplayName = "Status"
            }
            time {
                DisplayName = "Time"
            }
        }
    }

    method enable_calibration_output {
        in {
            f {
                DisplayName = "Calibration Frequency"
            }
        }
        out {
            status {
                DisplayName = "Status"
            }
        }
    }

    method configure_rtc_calibration_parameters {
        in {
            calp {
                DisplayName = "CALP"
            }
            calm {
                DisplayName = "CALM"
            }
        }
        out {
            status {
                DisplayName = "Status"
            }
        }
    }

    method retrieve_rtc_calibration_parameters {
        out {
            calp {
                DisplayName = "CALP"
            }
            calm {
                DisplayName = "CALM"
            }
        }
    }

    method get_rtc_clock_source {
        out {
            status {
                DisplayName = "Status"
            }
            info {
                DisplayName = "Info"
            }
        }
    }

}