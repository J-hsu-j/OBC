
import "../../spec/SpaceOpsMappingSpec.fdepl"
import "../../fp/task_stat.fidl"

define org.endurosat.spec.SpaceOpsMappingSpec for interface
endurosat.macif.task_stat as task_stat_Definitions {

	enumeration OpStatus {
		AlarmInvalidRegexValues = {
			"ERROR"
		}
	}

	struct StatsConfig {
		enable {
			DisplayName = "Enable"
		}
		logging {
			DisplayName = "Logging"
			DefaultValue = "8"
			AlarmNumericMaxInclusive = "56"
		}
		priority {
			DisplayName = "Priority"
		}
		period {
			DisplayName = "Period"
			Unit = "s"
		}
		task_id_table_file {
			DisplayName = "Task ID Table File"
		}
	}

	struct TaskStatConfig {
		id {
			DisplayName = "ID"
		}
		enabled {
			DisplayName = "Enabled"
		}
		logging {
			DisplayName = "Logging"
		}
	}

	struct TaskStatSample {
		id {
			DisplayName = "ID"
		}
		free_stack {
			DisplayName = "Free Stack"
			Unit = "B"
		}
		run_time {
			DisplayName = "Run Time"
			Unit = "s"
		}
	}

	method get_configuration {
		out {
			status {
				DisplayName = "Status"
			}
			config {
				DisplayName = "Configuration"
			}
		}
	}

	method set_configuration_global_enable {
		in {
			enable {
				DisplayName = "Enable"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method set_configuration_global_logging {
		in {
			logging {
				DisplayName = "Logging"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method set_configuration_global_priority {
		in {
			priority {
				DisplayName = "Priority"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method set_configuration_global_sampling_period {
		in {
			sampling_period {
				DisplayName = "Sampling Period"
				Unit = "s"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method set_configuration_global_id_file {
		in {
			task_id_table_file {
				DisplayName = "Task ID Table File"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method set_configuration_global_defaults {
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method get_configuration_per_task_id {
		in {
			id {
				DisplayName = "ID"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
			task_cfg {
				DisplayName = "Task Configuration"
			}
		}
	}

	method set_configuration_per_task_id {
		in {
			task_cfg {
				DisplayName = "Task Configuration"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
		}
	}

	method get_free_heap {
		out {
			status {
				DisplayName = "Status"
			}
			free_heap {
				DisplayName = "Free Heap"
				Unit = "B"
			}
		}
	}

	method get_latest_task_stat {
		in {
			id {
				DisplayName = "ID"
			}
		}
		out {
			status {
				DisplayName = "Status"
			}
			stat {
				DisplayName = "Statistics"
			}
		}
	}

}