
import "../../spec/SpaceOpsMappingSpec.fdepl"
import "../../cp/OBC_CP_GW.fidl"

define org.endurosat.spec.SpaceOpsMappingSpec for interface
endurosat.macif.cp.OBC_CP_GW as OBC_CP_GW_Definitions {

    struct SXBandGwCmdReq {
        Identifier {
            DisplayName = "Identifier"
        }
        Cmd {
            DisplayName = "Command"
        }
        Type {
            DisplayName = "Type"
        }
        DataLen {
            DisplayName = "Data Length"
            Unit = "B"
        }
        Data {
            DisplayName = "Data"
        }
    }

    struct MacFpCmdReq {
        Size {
            DisplayName = "Size"
            Unit = "B"
        }
        Data {
            DisplayName = "Data"
        }
    }

    struct SXBandSchedCmdReq {
        reset_pwr_before_sched_start {
            DisplayName = "Reset Power Before Schedule Start"
        }
        run_from_existing_file {
            DisplayName = "Run From Existing File"
        }
        file_name {
            DisplayName = "File Name"
        }
        sched_file_content {
            DisplayName = "Schedule File Content"
        }
    }

    enumeration FileOpStatus {
        AlarmInvalidRegexValues = {
            "(^(?!FR_OK$).*$)"
        }
    }

    enumeration SchedStatus {
        AlarmInvalidRegexValues = {
            "(^(?!SXBAND_SCHED_STATUS_OK$).*$)"
        }
    }

    struct SXBandSchedCmdResp {
        file_op_res {
            DisplayName = "File Operation Result"
        }
        bytes_written {
            DisplayName = "Bytes Written"
            Unit = "B"
        }
        sched_status {
            DisplayName = "Schedule Status"
        }
    }

    method SXBand_GwSendCmd {
        in {
            cmdData {
                DisplayName = "Command Data"
            }
        }
        out {
            responseData {
                DisplayName = "Response Data"
            }
        }
    }

    method CubeADCS_GwSendCmd {
        in {
            cmdId {
                DisplayName = "Command ID"
            }
            cmdBytes {
                DisplayName = "Command Bytes"
            }
        }
        out {
            responseData {
                DisplayName = "Response Data"
            }
        }
    }

    method MacFp_GwSendCmd {
        in {
            cmdData {
                DisplayName = "Command Data"
            }
        }
        out {
            responseData {
                DisplayName = "Response Data"
            }
        }
    }

    method SXBandSched_Run {
        in {
            req {
                DisplayName = "Request"
            }
        }
        out {
            resp {
                DisplayName = "Response"
            }
        }
    }

    method SXBandSched_Poll_Status {
        out {
            sched_status {
                DisplayName = "Schedule Status"
            }
            summary_f_name {
                DisplayName = "Summary File Name"
            }
        }
    }

}