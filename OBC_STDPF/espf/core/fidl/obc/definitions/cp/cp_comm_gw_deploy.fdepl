
import "../../spec/SpaceOpsMappingSpec.fdepl"
import "../../cp/cp_comm_gw.fidl"

define org.endurosat.spec.SpaceOpsMappingSpec for interface 
endurosat.comm.cp.cp_comm_gw as cp_comm_gw_Definitions {

    enumeration gw_res {
        AlarmInvalidRegexValues = {
            "(^(?!OK$).*$)"
        }
    }

    method send_fp {
        in {
            mac_if_id {
                DisplayName = "MAC Interface ID"
            }
            target_node_addr {
                DisplayName = "Target Node Address"
            }
            msg_prio {
                DisplayName = "Message Priority"
            }
            resp_timeout {
                DisplayName = "Response Timeout"
                Unit = "ms"
            }
            req_size {
                DisplayName = "Request Size"
                Unit = "B"
            }
            req_data {
                DisplayName = "Request Data"
            }
        }
        out {
            op_res {
                DisplayName = "Result"
            }
            resp_size {
                DisplayName = "Response Size"
                Unit = "B"
            }
            resp_data {
                DisplayName = "Response Data"
            }
        }
    }

    method send_csp {
        in {
            target_node_addr {
                DisplayName = "Target Node Address"
            }
            port {
                DisplayName = "Port"
            }
            msg_prio {
                DisplayName = "Message Priority"
            }
            opts {
                DisplayName = "Options"
            }
            resp_timeout {
                DisplayName = "Response Timeout"
                Unit = "ms"
            }
            req_size {
                DisplayName = "Request Size"
                Unit = "B"
            }
            req_data {
                DisplayName = "Request Data"
            }
        }
        out {
            op_res {
                DisplayName = "Result"
            }
            resp_size {
                DisplayName = "Response Size"
                Unit = "B"
            }
            resp_data {
                DisplayName = "Response Data"
            }
        }
    }

}