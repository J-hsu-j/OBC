# This is the absolute path to the macaron build wrapper script.
cmake_path(SET MACARON_PY "${CMAKE_SOURCE_DIR}/macaron.py")

# the following file is generated by the macaron.py script and contains the configuration name;
# a workaround due to the fact that generator expressions (i.e. <CONFIG>) cannot be accessed with
# certain cmake commands to obtain the actual build configuration requested by the user
include("${CMAKE_SOURCE_DIR}/build_cfg.cmake")

find_package(Python3 3.10 COMPONENTS Interpreter REQUIRED)

if (NOT Python3_FOUND)
    message(FATAL ERROR "Python 3.10+ is not installed on your system. The build process will be interrupted.")
endif()

# This variable is used in all CMakeLists.txt files which include this file and
# need to execute the macaron build wrapper directly. Only command options need
# to be provided by the users.
set(MACARON_CMD ${Python3_EXECUTABLE} ${MACARON_PY})

# This is a short-cut definition for the FIDL code generation command of the macaron
# build wrapper. Modules which include this file and would like to execute FIDL
# generation with specific options, can use this variable directly.
set(FP_GEN_CMD ${MACARON_CMD} -fp)

# This is a short-cut definition for the DataCache code generation command of the macaron
# build wrapper. Modules which include this file and would like to execute DC
# generation with specific options, can use this variable directly.
set(DC_GEN_CMD ${MACARON_CMD} -datacache)

#
# function FP_GEN:
# The function performs generation of C source code from a macchiato deployment schema file.
# Parameters:
#     <OUTPUT_SRC_LIST>: a list of all generated C source files to be used as dependencies of the
#                       custom command added to the module in order to re-trigger a build if the
#                       code generation modifies those sources
#     <FDEPL_FILE_NAME>: full path to the macchiato deployment schema file used for the code generation
#       <FIDL_DEP_LIST>: list of all FIDL files referred to by <FDEPL_FILE_NAME> to be used as dependencies
#                       for the custom command added to the module. This way, if a FIDL file gets modified,
#                       the code generation will be triggered automatically by CMake.
#
# Example:
#      You can use code similar to the following in your own CMakeLists.txt file:
#
#      include(${ROOT_BUILD_PATH}/espf.cmake)
#
#     cmake_path(SET beacons_fdepl_path "${PROJECT_SOURCE_DIR}/config/Beacons.fdepl")
#     cmake_path(SET beacons_fidl_path "${FIDL_ROOT_OBC}/Beacons.fidl")
#
#     list(APPEND fp_beacons_src_list
#         ${PROJECT_SOURCE_DIR}/fp/Beacons/v0.1/Beacons_server/FP_BeaconsProtocolServer.c
#         ${PROJECT_SOURCE_DIR}/fp/Beacons/v0.1/Beacons_server/FP_BeaconsProtocolServer.h
#         ${PROJECT_SOURCE_DIR}/fp/Beacons/v0.1/Beacons_server/FP_BeaconsProtocolTypes.h
#         ${PROJECT_SOURCE_DIR}/fp/Beacons/v0.1/Beacons_server/FP_BeaconsServerApp.c
#         ${PROJECT_SOURCE_DIR}/fp/Beacons/v0.1/Beacons_server/FP_BeaconsServerApp.h
#     )
#
#     FP_GEN(fp_beacons_src_list ${beacons_fdepl_path} beacons_fidl_path)
#
#     The code above will trigger FIDL code generation for file Beacons.fidl if:
#       - Beacons.fidl file gets modified.
#         - Beacons.fdepl file gets modified.
#      In addition to that, when the code generation command producing the files listed in ${fp_beacons_src_list}
#      executes, any CMake targets listing those files as part of their source list will get rebuilt through the
#     CMake dependency tree.
function(FP_GEN OUTPUT_SRC_LIST FDEPL_FILE_NAME FIDL_DEP_LIST)
    add_custom_command(OUTPUT ${${OUTPUT_SRC_LIST}}
        COMMAND ${FP_GEN_CMD} -dc ${FDEPL_FILE_NAME} VERBATIM
        DEPENDS ${${FIDL_DEP_LIST}} VERBATIM)
endfunction(FP_GEN)

# function FP_GEN_AT_PATH:
# The function performs exactly the same action as FP_GEN but can be given an additional parameter
# <GEN_PATH> which specifies in which folder the macchiato-generated files will be placed.
function(FP_GEN_AT_PATH OUTPUT_SRC_LIST FDEPL_FILE_NAME FIDL_DEP_LIST GEN_PATH)
    add_custom_command(OUTPUT ${${OUTPUT_SRC_LIST}}
        COMMENT "Processing fp generation for ${${OUTPUT_SRC_LIST}}"
        COMMAND ${FP_GEN_CMD} -dc ${FDEPL_FILE_NAME} -fmr ${GEN_PATH} VERBATIM
        DEPENDS ${${FIDL_DEP_LIST}} VERBATIM)
endfunction(FP_GEN_AT_PATH)

# Get the project version from the version file. It is expecting a format of major.minor.patch.
# Params: 
#   - FILE_PATH: version file path
#   - MAX_OBC_VER_STR_LENGTH: maximum length to reserve in the code for storing the version string
#   - FIXED_VER_PREFIX: fixed version prefix (if required, e.g. "STDPF-H7-")
# This function will set the variables that can be used as compilation defines:
#   - {project}_VERSION_MAJOR
#   - {project}_VERSION_MINOR
#   - {project}_VERSION_PATCH
#   - {project}_VERSION_LABEL
#   - {project}_VERSION_LABEL_TRIMMED (trimmed string to match MAX_OBC_VER_STR_LENGTH)
function(define_version_from_file FILE_PATH MAX_OBC_VER_STR_LENGTH FIXED_VER_PREFIX)
    # Read the file contents into a variable
    file(READ ${FILE_PATH} VERSION_CONTENTS)

    # Extract the version numbers using regular expressions
    string(REGEX MATCH "([0-9]+)\\.([0-9]+)\\.([0-9]+)[-]?([a-zA-Z0-9_-]*)" MATCHED_VERSION "${VERSION_CONTENTS}")

    # Extract the major, minor, and patch versions from the matched string
    if(NOT ${CMAKE_MATCH_1} STREQUAL "")
        set(${CMAKE_PROJECT_NAME}_VERSION_MAJOR ${CMAKE_MATCH_1} PARENT_SCOPE)
    else()
        # Set 0 if the version file contains an invalid format
        set(${CMAKE_PROJECT_NAME}_VERSION_MAJOR 99 PARENT_SCOPE)
    endif()

    if(NOT ${CMAKE_MATCH_2} STREQUAL "")
        set(${CMAKE_PROJECT_NAME}_VERSION_MINOR ${CMAKE_MATCH_2} PARENT_SCOPE)
    else()
        set(${CMAKE_PROJECT_NAME}_VERSION_MINOR 99 PARENT_SCOPE)
    endif()

    if(NOT ${CMAKE_MATCH_3} STREQUAL "")
        set(${CMAKE_PROJECT_NAME}_VERSION_PATCH ${CMAKE_MATCH_3} PARENT_SCOPE)
    else()
        set(${CMAKE_PROJECT_NAME}_VERSION_PATCH 99 PARENT_SCOPE)
    endif()

    if(NOT ${CMAKE_MATCH_4} STREQUAL "")
        set(${CMAKE_PROJECT_NAME}_VERSION_LABEL ${CMAKE_MATCH_4} PARENT_SCOPE)
    # If the version file doesn't match the regex, set the label to its contents
    elseif("${CMAKE_MATCH_1}" STREQUAL "" OR "${CMAKE_MATCH_2}" STREQUAL "" OR "${CMAKE_MATCH_3}" STREQUAL "")
        set(${CMAKE_PROJECT_NAME}_VERSION_LABEL "${VERSION_CONTENTS}" PARENT_SCOPE)
    endif()
    
    string(STRIP "${VERSION_CONTENTS}" STRIP_VERSION)
    string(CONCAT FULL_VER_STR ${FIXED_VER_PREFIX} ${STRIP_VERSION})
    
    string(LENGTH "${FULL_VER_STR}" STR_LEN)
    if (${STR_LEN} GREATER ${MAX_OBC_VER_STR_LENGTH})
        string(SUBSTRING "${FULL_VER_STR}" 0 ${MAX_OBC_VER_STR_LENGTH} TRIMMED_VERSION)
    else()
        set(TRIMMED_VERSION "${FULL_VER_STR}")
    endif()
    
    set(${CMAKE_PROJECT_NAME}_VERSION_LABEL_TRIMMED "${TRIMMED_VERSION}" PARENT_SCOPE)
endfunction(define_version_from_file)

#
# function GENERATE_LIB_PATH:
# This function constructs a full library path by appending several standard path components to the base directory
# (`CMAKE_SOURCE_DIR`). It is designed to automate the generation of library paths based on a typical project directory
# structure, enhancing consistency across different configurations and platforms. This centralized approach to path
# generation reduces potential errors and simplifies library path management across the project.
#
# Parameters:
#   <PREBUILT_LIB_NAME> (string): The filename of the prebuilt library, including any file extension (e.g., libexample.a).
#                                 This is used as the final component in the path construction.
#   <RESULT_VAR> (string): The name of the variable in which the fully constructed library path will be stored. The function
#                          sets this variable in the parent scope for further use in linking commands or path-dependent configurations.
#
# Example:
# Below is an example of how to use GENERATE_LIB_PATH in your CMakeLists.txt to generate paths for library dependencies:
#
#     # Define the variable to store the generated library path
#     set(full_library_path "")
#
#     # Generate the full path for a prebuilt library named 'example_lib'
#     GENERATE_LIB_PATH("example_lib" full_library_path)
#
#     # Now, 'full_library_path' contains the path to 'example_lib', constructed as follows:
#     # "${CMAKE_SOURCE_DIR}/../lib/${BUILD_CFG_NAME}/example_lib"
#     # You can use this path to link the library, check its existence, or perform other file-based operations.
#     message("Generated library path: ${full_library_path}")
#
# This function constructs the path by appending "../lib/${BUILD_CFG_NAME}/" to `CMAKE_SOURCE_DIR`, followed by the library name.
# This assumes a project structure where libraries are stored in a 'lib' directory outside the source directory, organized by
# build configuration.
function(GENERATE_LIB_PATH PREBUILT_LIB_NAME RESULT_VAR)
    cmake_path(APPEND FULL_LIB_PATH "${CMAKE_SOURCE_DIR}" ".." "lib" "${BUILD_CFG_NAME}" "${PREBUILT_LIB_NAME}")
    set(${RESULT_VAR} "${FULL_LIB_PATH}" PARENT_SCOPE)
endfunction()

#
# function FIND_AND_APPEND_LIB:
# This function first constructs the expected full path of a library using `GENERATE_LIB_PATH`. It then attempts to
# find the specified library at that path. If the library is found, its full path is appended to a provided list variable;
# if not found, the library's name is appended instead. This allows for flexible handling of library dependencies,
# accommodating scenarios where libraries may either be pre-compiled or expected to be built from source.
#
# Parameters:
#   <LIB_NAME> (string): The filename or base name of the library to find, without any path but including the extension if applicable.
#   <OUTPUT_LIST> (string): The name of the list variable to which the found library path or its name will be appended.
#
# Note:
# The function modifies the list variable in the parent scope, ensuring that changes are visible outside the function and can
# be used in further commands like `target_link_libraries`.
#
# Example:
# Below is an example of how to use FIND_AND_APPEND_LIB to manage library dependencies:
#
#     set(my_project_libs "")
#     FIND_AND_APPEND_LIB("example_lib.a" "my_project_libs")
#     target_link_libraries(my_target PRIVATE ${my_project_libs})
#
# This function searches for 'example_lib.a' using the path generated by `GENERATE_LIB_PATH`. If found, the full path is appended
# to 'my_project_libs'; if not found, 'example_lib.a' is appended as a fallback. The resulting list can be used to link libraries to
# a target, handling both present and absent libraries effectively.
function(FIND_AND_APPEND_LIB LIB_NAME OUTPUT_LIST)
    # Generate the path to the expected library location using the build configuration
    GENERATE_LIB_PATH(${LIB_NAME} LIB_PATH)

    # Get the directory from the full path
    get_filename_component(LIB_DIR ${LIB_PATH} DIRECTORY)

    # Attempt to find the specified library
    find_library(FOUND_LIB NAMES ${LIB_NAME} PATHS ${LIB_DIR} NO_DEFAULT_PATH)

    # If the library is not found, use its name directly
    if(NOT FOUND_LIB)
        set(FOUND_LIB ${LIB_NAME})
    endif()

    # Append the library to the given list variable
    list(APPEND ${OUTPUT_LIST} ${FOUND_LIB})

    # Set the modified list in the parent scope
    set(${OUTPUT_LIST} "${${OUTPUT_LIST}}" PARENT_SCOPE)
endfunction()
