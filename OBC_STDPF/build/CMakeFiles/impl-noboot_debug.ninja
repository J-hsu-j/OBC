#############################################
# Link the static library espf\arch\stm32h753iit\drivers\noboot_debug\libdrv_led.a

build espf/arch/stm32h753iit/drivers/noboot_debug/libdrv_led.a: C_STATIC_LIBRARY_LINKER__drv_led_noboot_debug espf/arch/stm32h753iit/drivers/CMakeFiles/drv_led.dir/noboot_debug/drv_led/src/drv_led.c.obj || espf/stm32_hal/noboot_debug/libstm32_hal.a
