# =============================================================================
# Link build statements for STATIC_LIBRARY target i2c


#############################################
# Link the static library espf\arch\stm32h753iit\drivers\noboot_debug\libi2c.a

build espf/arch/stm32h753iit/drivers/noboot_debug/libi2c.a: C_STATIC_LIBRARY_LINKER__i2c_noboot_debug espf/arch/stm32h753iit/drivers/CMakeFiles/i2c.dir/noboot_debug/comm/i2c/MX_I2C.c.obj || espf/stm32_hal/noboot_debug/libstm32_hal.a
  CONFIG = noboot_debug
  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb
  OBJECT_DIR = espf\arch\stm32h753iit\drivers\CMakeFiles\i2c.dir\noboot_debug
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = espf\arch\stm32h753iit\drivers\CMakeFiles\i2c.dir\noboot_debug\i2c.pdb
  TARGET_FILE = espf\arch\stm32h753iit\drivers\noboot_debug\libi2c.a
  TARGET_PDB = espf\arch\stm32h753iit\drivers\noboot_debug\libi2c.pdb
  TARGET_SUPPORT_DIR = espf\arch\stm32h753iit\drivers\CMakeFiles\i2c.dir

