  CONFIG = release
  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard -mthumb -O3 -DNDEBUG
  OBJECT_DIR = espf\arch\stm32h753iit\drivers\CMakeFiles\can.dir\release
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = espf\arch\stm32h753iit\drivers\CMakeFiles\can.dir\release\can.pdb
